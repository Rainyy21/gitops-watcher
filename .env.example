GITEA_TOKEN=your-real-token
GITHUB_TOKEN=your-real-token
WEB_SECRET_KEY=change-me
# generate with: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# web UI login (empty or placeholder hash = nobody can log in)
WEB_ADMIN_USER=admin
# generate with:
#   python3 -c "from werkzeug.security import generate_password_hash as g; import getpass; print(g(getpass.getpass()))"
# keep the single quotes: the hash contains $ and compose would read those as variables
WEB_ADMIN_PASSWORD_HASH='change-me'

# encrypts the repo .env files saved from the web UI (data/local/) at rest.
# back it up somewhere else: lose it and those files can't be read anymore
# generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENV_ENCRYPTION_KEY=
